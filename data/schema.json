{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nietzsche quote corpus",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "work",
      "workTitleDe",
      "workTitleKo",
      "part",
      "section",
      "paragraph",
      "paragraphCount",
      "sentence",
      "german",
      "korean",
      "footnotes"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 12 },
      "work": { "enum": ["jgb", "gm", "ac", "gd", "fw"] },
      "workTitleDe": { "type": "string" },
      "workTitleKo": { "type": "string" },
      "part": { "type": "string" },
      "partTitleDe": { "type": "string" },
      "partTitleKo": { "type": "string" },
      "section": { "type": "string" },
      "sectionTitleDe": { "type": "string" },
      "paragraph": { "type": "integer", "minimum": 0 },
      "paragraphCount": { "type": "integer", "minimum": 1 },
      "sentence": { "type": "integer", "minimum": 0 },
      "german": { "type": "string", "minLength": 24 },
      "korean": { "type": "string" },
      "translationStatus": { "enum": ["pending", "draft", "reviewed"] },
      "footnotes": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["label", "text"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "sourceUrl": { "type": "string", "format": "uri" }
    }
  }
}
