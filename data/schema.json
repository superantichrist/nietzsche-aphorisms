{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "German philosophy sentence corpus",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "author",
      "authorNameDe",
      "authorNameKo",
      "work",
      "workTitleDe",
      "workTitleKo",
      "part",
      "section",
      "paragraph",
      "paragraphCount",
      "sentence",
      "german",
      "korean",
      "footnotes"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 12 },
      "author": { "enum": ["nietzsche", "schopenhauer"] },
      "authorNameDe": { "type": "string", "minLength": 1 },
      "authorNameKo": { "type": "string", "minLength": 1 },
      "work": { "enum": ["jgb", "gm", "ac", "gd", "fw", "za", "eh", "nf", "pp"] },
      "workTitleDe": { "type": "string" },
      "workTitleKo": { "type": "string" },
      "edition": { "type": "string" },
      "editor": { "type": "string" },
      "transcriptionStatus": { "type": "string" },
      "volume": { "type": "string" },
      "volumeTitleDe": { "type": "string" },
      "volumeTitleKo": { "type": "string" },
      "part": { "type": "string" },
      "partTitleDe": { "type": "string" },
      "partTitleKo": { "type": "string" },
      "section": { "type": "string" },
      "sectionLabel": { "type": "string" },
      "sectionTitleDe": { "type": "string" },
      "sectionTitleKo": { "type": "string" },
      "paragraph": { "type": "integer", "minimum": 0 },
      "paragraphCount": { "type": "integer", "minimum": 1 },
      "sentence": { "type": "integer", "minimum": 0 },
      "german": { "type": "string", "minLength": 24 },
      "korean": { "type": "string" },
      "translationStatus": { "enum": ["pending", "draft", "reviewed"] },
      "footnotes": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["label", "text"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "minLength": 1 },
            "language": { "enum": ["de", "ko"] },
            "kind": { "enum": ["source-edition", "editorial"] }
          },
          "additionalProperties": false
        }
      },
      "sourceUrl": { "type": "string", "format": "uri" },
      "sourceFile": { "type": "string" }
    }
  }
}
